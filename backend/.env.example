# Application
APP_ENV=development
APP_BASE_URL=https://your-cloud-run-service.run.app
APP_VERSION=1.0.0

# Database (Cloud SQL via Cloud SQL Auth Proxy or direct connection)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/copper_crm_plugin

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GCS_BUCKET=your-gcs-bucket-name
PUBSUB_TOPIC_EVENTS=copper-crm-events
PUBSUB_SUBSCRIPTION_EVENTS=copper-crm-events-sub

# RingCentral
RINGCENTRAL_CLIENT_ID=your-ringcentral-client-id
RINGCENTRAL_CLIENT_SECRET=your-ringcentral-client-secret
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN=your-ringcentral-validation-token
RINGCENTRAL_JWT=your-ringcentral-jwt-credential

# Copper CRM
COPPER_CLIENT_ID=your-copper-client-id
COPPER_CLIENT_SECRET=your-copper-client-secret
COPPER_REDIRECT_URI=https://your-cloud-run-service.run.app/oauth/copper/callback

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Vertex AI / Gemini
VERTEX_MODEL=gemini-1.5-pro

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
